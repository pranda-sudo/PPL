{
  "name": "ppl-testy-mobile",
  "version": "1.0.0",
  "description": "Mobilni wrapper PPL Testy pro iOS a Android.",
  "private": true,
  "scripts": {
    "sync:web": "node scripts/sync-web.js",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "check:mobile": "node scripts/check-readiness.js",
    "check:release": "node scripts/check-readiness.js --release"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@capacitor/ios": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
